        "title": { "type": "title", "settings": {} },
        "rating": { "type": "rating", "settings": { "stars": 5, "text": "" } },
        "price": { "type": "price", "settings": { "show_taxes_note": true } },
        "stock": { "type": "stock", "settings": {} },
        "variant_picker": { "type": "variant_picker", "settings": {} },
        "buy": { "type": "quantity_and_buy", "settings": { "show_dynamic_checkout": true } },
