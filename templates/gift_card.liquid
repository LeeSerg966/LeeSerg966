{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }} — Gift card</title>
    {{ settings.font_body | font_face: font_display: 'swap' }}
    {% style %}
      :root {
        --color-background: {{ settings.color_background }};
        --color-surface: {{ settings.color_surface }};
        --color-text: {{ settings.color_text }};
        --color-text-muted: {{ settings.color_text_muted }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-text: {{ settings.color_accent_text }};
        --color-border: {{ settings.color_border }};
        --color-accent-dark: {{ settings.color_accent | color_darken: 8 }};
        --font-body-family: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
        --font-body-style: normal;
        --font-body-weight: 400;
        --font-heading-family: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
        --font-heading-style: normal;
        --font-heading-weight: 700;
        --font-body-scale: 1;
        --font-heading-scale: 1;
        --heading-transform: none;
        --page-width: 900px;
        --radius: {{ settings.corner_radius }}px;
        --radius-sm: {{ settings.corner_radius | divided_by: 2 }}px;
        --button-radius: 999px;
      }
      .gift-card { max-width: 46rem; margin: 6rem auto; padding: 0 2rem; text-align: center; }
      .gift-card__code {
        display: inline-block;
        margin: 2.4rem 0 1.6rem;
        padding: 1.6rem 2.4rem;
        border: 2px dashed var(--color-border);
        border-radius: var(--radius);
        background: var(--color-surface);
        font-size: 2.2rem;
        font-weight: 700;
        letter-spacing: 0.12em;
      }
      .gift-card__qr { margin: 2.4rem auto; }
    {% endstyle %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
  </head>

  <body>
    <div class="gift-card">
      <h1>{{ shop.name }}</h1>
      <p class="text-muted">Here's your gift card</p>

      <div class="h0">{{ gift_card.initial_value | money_with_currency }}</div>

      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="form-message form-message--error">This gift card is no longer valid.</p>
      {%- endif -%}

      <div class="gift-card__code">{{ gift_card.code | format_code }}</div>

      {%- if gift_card.balance != gift_card.initial_value -%}
        <p class="text-muted">Remaining balance: {{ gift_card.balance | money_with_currency }}</p>
      {%- endif -%}

      {%- if gift_card.expires_on -%}
        <p class="text-muted">Expires on {{ gift_card.expires_on | date: format: 'date' }}</p>
      {%- endif -%}

      <div class="gift-card__qr" id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>

      <a href="{{ shop.url }}" class="btn">Start shopping</a>

      <p class="text-muted" style="margin-top:2.4rem;font-size:1.3rem">
        Use this code at checkout. Keep it somewhere safe — anyone with the code can spend it.
      </p>
    </div>

    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var target = document.getElementById('QrCode');
        if (target && window.QRCode) {
          new QRCode(target, {
            text: target.dataset.identifier,
            width: 160,
            height: 160,
            imageAltText: 'Gift card QR code'
          });
        }
      });
    </script>
  </body>
</html>
