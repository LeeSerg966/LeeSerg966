<div class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width">
    <div class="contact-layout">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte text-muted">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="image-with-text__list" style="margin-top:2.4rem">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                {% render 'icon', icon: block.settings.icon %}
                <span>
                  <strong>{{ block.settings.heading }}</strong><br>
                  <span class="text-muted">{{ block.settings.text }}</span>
                </span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="card-panel">
        {%- form 'contact' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success">{{ 'contact.form.post_success' | t }}</p>
          {%- elsif form.errors -%}
            <div class="form-message form-message--error">{{ form.errors | default_errors }}</div>
          {%- endif -%}

          <div class="field">
            <label for="ContactName">{{ 'contact.form.name' | t }}</label>
            <input type="text" id="ContactName" name="contact[name]" value="{{ form.name }}" autocomplete="name" required>
          </div>

          <div class="field">
            <label for="ContactEmail">{{ 'contact.form.email' | t }}</label>
            <input type="email" id="ContactEmail" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
          </div>

          <div class="field">
            <label for="ContactPhone">{{ 'contact.form.phone' | t }}</label>
            <input type="tel" id="ContactPhone" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
          </div>

          <div class="field">
            <label for="ContactBody">{{ 'contact.form.message' | t }}</label>
            <textarea id="ContactBody" name="contact[body]" rows="5" required>{{ form.body }}</textarea>
          </div>

          <button type="submit" class="btn btn--full">{{ 'contact.form.send' | t }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk to a real person" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Questions about sizing, shipping or which grinder suits a nervous dog? Send us a note — we answer every message within 24 hours.</p>"
    },
    { "type": "checkbox", "id": "surface", "label": "Tinted background", "default": false }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Detail",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "chat", "label": "Chat" },
            { "value": "clock", "label": "Clock" },
            { "value": "truck", "label": "Shipping" },
            { "value": "return", "label": "Returns" }
          ],
          "default": "chat"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Email" },
        { "type": "text", "id": "text", "label": "Text", "default": "hello@example.com" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact form",
      "blocks": [{ "type": "item" }, { "type": "item", "settings": { "icon": "clock", "heading": "Support hours", "text": "Mon–Fri, 9am–6pm ET" } }]
    }
  ]
}
{% endschema %}
