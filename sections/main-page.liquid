<div class="section">
  <div class="page-width{% if section.settings.narrow %} page-width--narrow{% endif %}">
    <h1{% if section.settings.center_title %} class="text-center"{% endif %}>{{ page.title }}</h1>

    {%- if page.content != blank -%}
      <div class="rte">{{ page.content }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "checkbox", "id": "narrow", "label": "Narrow width", "default": true },
    { "type": "checkbox", "id": "center_title", "label": "Center title", "default": false }
  ]
}
{% endschema %}
