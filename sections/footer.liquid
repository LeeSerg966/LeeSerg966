<footer class="footer">
  <div class="page-width">
    <div class="footer__grid">
      <div class="footer__brand">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: 300 }}"
            alt="{{ shop.name | escape }}"
            width="150"
            height="auto"
            loading="lazy"
            style="max-width:150px;margin-bottom:1.6rem">
        {%- else -%}
          <div class="header__logo" style="margin-bottom:1.2rem">
            {% render 'icon', icon: 'paw' %}
            {{ shop.name }}
          </div>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text }}</p>
        {%- endif -%}

        {% render 'social-icons' %}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div {{ block.shopify_attributes }}>
              <h3 class="footer__heading">{{ block.settings.heading }}</h3>
              <ul class="footer__list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'text' -%}
            <div {{ block.shopify_attributes }}>
              <h3 class="footer__heading">{{ block.settings.heading }}</h3>
              <div class="rte text-muted" style="font-size:1.4rem">{{ block.settings.content }}</div>
            </div>

          {%- when 'newsletter' -%}
            <div {{ block.shopify_attributes }}>
              <h3 class="footer__heading">{{ block.settings.heading }}</h3>
              <p class="text-muted" style="font-size:1.4rem">{{ block.settings.text }}</p>

              {%- form 'customer', class: 'newsletter__form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                {%- if form.posted_successfully? -%}
                  <p class="form-message form-message--success">{{ 'general.newsletter.success' | t }}</p>
                {%- endif -%}
                <div class="field">
                  <label class="visually-hidden" for="FooterNewsletter">{{ 'general.newsletter.label' | t }}</label>
                  <input
                    type="email"
                    id="FooterNewsletter"
                    name="contact[email]"
                    placeholder="{{ 'general.newsletter.placeholder' | t }}"
                    autocomplete="email"
                    required>
                </div>
                <button type="submit" class="btn">{{ 'general.newsletter.submit' | t }}</button>
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <div>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'sections.footer.copyright' | t }}
        {%- if section.settings.show_powered_by -%}
          &nbsp;{{ powered_by_link }}
        {%- endif -%}
      </div>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="footer__payment" role="list" aria-label="{{ 'sections.footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <span role="listitem">{{ type | payment_type_svg_tag: class: 'payment-icon' }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Brand text",
      "default": "Practical, well-made gear for dogs and cats — designed for calm grooming days, muddy walks and everything in between."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "Show \"Powered by Shopify\"",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Help"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Questions? Email us at hello@example.com — we reply within 24 hours.</p>"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Stay in the loop"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "New drops, care tips and subscriber-only offers."
        }
      ]
    }
  ]
}
{% endschema %}
