<div class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width">
    <div class="image-with-text{% if section.settings.reverse %} image-with-text--reverse{% endif %}">
      <div class="image-with-text__media">
        {%- if section.settings.video != blank -%}
          <div class="image-with-text__video">
            {{
              section.settings.video
              | video_tag:
                image_size: '1000x',
                autoplay: true,
                loop: true,
                muted: true,
                controls: false,
                playsinline: true
            }}
          </div>
        {%- elsif section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 750px) 50vw, 100vw"
            alt="{{ section.settings.image.alt | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy">
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="image-with-text__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="image-with-text__list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                {% render 'icon', icon: 'check' %}
                <span>
                  <strong>{{ block.settings.heading }}</strong>
                  {%- if block.settings.text != blank -%}
                    <br><span class="text-muted">{{ block.settings.text }}</span>
                  {%- endif -%}
                </span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="btn" style="margin-top:2.8rem">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with text",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "video", "id": "video", "label": "Video", "info": "Replaces the image, plays muted on loop." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for the pets who hate sitting still" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Every tool we ship is tested on real dogs and cats — the wriggly ones, the nervous ones, the ones who hear the clipper and vanish. If it doesn't work on them, it doesn't get made.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "reverse", "label": "Image on the right", "default": false },
    { "type": "checkbox", "id": "surface", "label": "Tinted background", "default": false }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Bullet point",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Whisper-quiet motor" },
        { "type": "text", "id": "text", "label": "Text", "default": "Under 50 dB, so nervous pets stay calm." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text",
      "blocks": [{ "type": "point" }, { "type": "point" }, { "type": "point" }]
    }
  ]
}
{% endschema %}
