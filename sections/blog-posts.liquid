<div class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width">
    <div class="section-header">
      <div class="section-header__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p>{{ section.settings.description }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.blog != blank -%}
        <a href="{{ section.settings.blog.url }}" class="link-arrow">
          View all
          {% render 'icon', icon: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>

    <div class="article-grid">
      {%- for article in section.settings.blog.articles limit: section.settings.posts_to_show -%}
        <article class="article-card">
          <a href="{{ article.url }}" class="article-card__media">
            {%- if article.image -%}
              <img
                src="{{ article.image | image_url: width: 900 }}"
                srcset="{{ article.image | image_url: width: 500 }} 500w, {{ article.image | image_url: width: 900 }} 900w"
                sizes="(min-width: 750px) 33vw, 100vw"
                alt="{{ article.image.alt | escape }}"
                width="{{ article.image.width }}"
                height="{{ article.image.height }}"
                loading="lazy">
            {%- else -%}
              {{ 'blog-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </a>

          <div class="article-card__body">
            <div class="article-card__meta">{{ article.published_at | date: format: 'date' }}</div>
            <h3 class="h4"><a href="{{ article.url }}">{{ article.title }}</a></h3>
            <p class="text-muted">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
          </div>
        </article>
      {%- else -%}
        <p class="text-muted">Pick a blog in the theme editor to show your latest posts here.</p>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Care guides" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "range", "id": "posts_to_show", "label": "Posts to show", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "surface", "label": "Tinted background", "default": false }
  ],
  "presets": [{ "name": "Blog posts" }]
}
{% endschema %}
