<div class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width page-width--narrow{% if section.settings.center %} text-center{% endif %}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}
          <span class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        {%- when 'heading' -%}
          <h2 {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
        {%- when 'text' -%}
          <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          <div style="margin-top:2.8rem" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link }}" class="btn{% unless block.settings.primary %} btn--secondary{% endunless %}">
              {{ block.settings.label }}
            </a>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "checkbox", "id": "center", "label": "Center text", "default": true },
    { "type": "checkbox", "id": "surface", "label": "Tinted background", "default": false }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Our promise" }]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Gear that earns its place in your hallway" }]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>We started Kesvaro after one too many kitchen-floor nail trims ended in blood and guilt. Everything we sell has to pass a simple test: does it make a stressful five minutes calmer?</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Our story" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "primary", "label": "Primary style", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "blocks": [{ "type": "eyebrow" }, { "type": "heading" }, { "type": "text" }]
    }
  ]
}
{% endschema %}
