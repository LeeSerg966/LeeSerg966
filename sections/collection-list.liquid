<div class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header{% if section.settings.center_heading %} section-header--center{% endif %}">
        <div class="section-header__text">
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          <h2>{{ section.settings.heading }}</h2>
          {%- if section.settings.description != blank -%}
            <p>{{ section.settings.description }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.show_view_all -%}
          <a href="{{ routes.collections_url }}" class="link-arrow">
            All collections
            {% render 'icon', icon: 'arrow-right' %}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="collection-list" style="--columns: {{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- assign block_collection = block.settings.collection -%}
        <li {{ block.shopify_attributes }}>
          <a href="{{ block_collection.url | default: routes.all_products_collection_url }}" class="collection-card">
            <div class="media media--{{ section.settings.image_ratio }}">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 900 }} 900w"
                  sizes="(min-width: 750px) 33vw, 50vw"
                  alt="{{ block.settings.image.alt | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy">
              {%- elsif block_collection.featured_image -%}
                <img
                  src="{{ block_collection.featured_image | image_url: width: 900 }}"
                  srcset="{{ block_collection.featured_image | image_url: width: 500 }} 500w, {{ block_collection.featured_image | image_url: width: 900 }} 900w"
                  sizes="(min-width: 750px) 33vw, 50vw"
                  alt="{{ block_collection.featured_image.alt | escape }}"
                  width="{{ block_collection.featured_image.width }}"
                  height="{{ block_collection.featured_image.height }}"
                  loading="lazy">
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
              <span class="collection-card__overlay"></span>
            </div>

            <div class="collection-card__content">
              <h3>{{ block.settings.heading | default: block_collection.title | default: 'Collection' }}</h3>
              {%- if block_collection != blank and section.settings.show_count -%}
                <span class="collection-card__count">{{ block_collection.all_products_count }} products</span>
              {%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Collection list",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "portrait"
    },
    { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": true },
    { "type": "checkbox", "id": "show_view_all", "label": "Show \"All collections\" link", "default": false },
    { "type": "checkbox", "id": "center_heading", "label": "Center heading", "default": false },
    { "type": "checkbox", "id": "surface", "label": "Tinted background", "default": false }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "heading", "label": "Custom title" },
        { "type": "image_picker", "id": "image", "label": "Custom image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
