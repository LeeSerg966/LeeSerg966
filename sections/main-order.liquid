<div class="section">
  <div class="page-width">
    <div class="customer customer--wide">
      <a href="{{ routes.account_url }}" class="link-arrow" style="margin-bottom:1.6rem">
        {% render 'icon', icon: 'chevron-left' %}
        {{ 'customer.account.return' | t }}
      </a>

      <h1>{{ 'customer.order.title' | t: name: order.name }}</h1>
      {%- assign order_date = order.created_at | date: format: 'date' -%}
      <p class="text-muted">{{ 'customer.order.date_html' | t: date: order_date }}</p>

      {%- if order.cancelled -%}
        <div class="form-message form-message--error">
          {{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason_label }}
        </div>
      {%- endif -%}

      <table style="margin-top:2.4rem">
        <thead>
          <tr>
            <th>{{ 'customer.order.product' | t }}</th>
            <th>{{ 'customer.order.price' | t }}</th>
            <th>{{ 'customer.order.quantity' | t }}</th>
            <th>{{ 'customer.order.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for line_item in order.line_items -%}
            <tr>
              <td>
                <a href="{{ line_item.product.url }}">{{ line_item.title }}</a>
                {%- if line_item.fulfillment -%}
                  <div class="text-muted" style="font-size:1.3rem">
                    {%- if line_item.fulfillment.tracking_url -%}
                      <a href="{{ line_item.fulfillment.tracking_url }}">{{ 'customer.order.track_shipment' | t }}</a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </td>
              <td>{{ line_item.price | money }}</td>
              <td>{{ line_item.quantity }}</td>
              <td>{{ line_item.line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot>
          <tr>
            <td colspan="3">{{ 'customer.order.subtotal' | t }}</td>
            <td>{{ order.line_items_subtotal_price | money }}</td>
          </tr>
          {%- for shipping_method in order.shipping_methods -%}
            <tr>
              <td colspan="3">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</td>
              <td>{{ shipping_method.price | money }}</td>
            </tr>
          {%- endfor -%}
          {%- for tax_line in order.tax_lines -%}
            <tr>
              <td colspan="3">{{ 'customer.order.tax' | t }} ({{ tax_line.title }} {{ tax_line.rate_percentage }}%)</td>
              <td>{{ tax_line.price | money }}</td>
            </tr>
          {%- endfor -%}
          <tr>
            <td colspan="3"><strong>{{ 'customer.order.total' | t }}</strong></td>
            <td><strong>{{ order.total_price | money_with_currency }}</strong></td>
          </tr>
        </tfoot>
      </table>

      <div style="display:grid;gap:2.4rem;grid-template-columns:repeat(auto-fit,minmax(26rem,1fr));margin-top:3.2rem">
        <div class="card-panel">
          <h2 class="h4">{{ 'customer.order.billing_address' | t }}</h2>
          <p class="text-muted" style="font-size:1.4rem">{{ 'customer.order.payment_status' | t }}: {{ order.financial_status_label }}</p>
          {{ order.billing_address | format_address }}
        </div>

        <div class="card-panel">
          <h2 class="h4">{{ 'customer.order.shipping_address' | t }}</h2>
          <p class="text-muted" style="font-size:1.4rem">{{ 'customer.order.fulfillment_status' | t }}: {{ order.fulfillment_status_label }}</p>
          {{ order.shipping_address | format_address }}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Order",
  "settings": []
}
{% endschema %}
