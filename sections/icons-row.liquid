<div class="section{% if section.settings.tight %} section--tight{% endif %}{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header section-header--center">
        <div class="section-header__text">
          <h2>{{ section.settings.heading }}</h2>
          {%- if section.settings.description != blank -%}
            <p>{{ section.settings.description }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="icons-row" style="--columns: {{ section.blocks.size | at_most: 4 }}">
      {%- for block in section.blocks -%}
        <div class="icon-block" {{ block.shopify_attributes }}>
          <span class="icon-block__icon">{% render 'icon', icon: block.settings.icon %}</span>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Value props",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "checkbox", "id": "surface", "label": "Tinted background", "default": true },
    { "type": "checkbox", "id": "tight", "label": "Reduce spacing", "default": false }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Shipping" },
            { "value": "return", "label": "Returns" },
            { "value": "shield", "label": "Guarantee" },
            { "value": "chat", "label": "Support" },
            { "value": "paw", "label": "Paw" },
            { "value": "heart", "label": "Heart" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "clock", "label": "Clock" },
            { "value": "lock", "label": "Secure" },
            { "value": "gift", "label": "Gift" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Free US shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "On every order, delivered in 5–8 business days." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value props",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "heading": "Free US shipping", "text": "On every order, delivered in 5–8 business days." } },
        { "type": "item", "settings": { "icon": "return", "heading": "30-day returns", "text": "Not the right fit? Send it back, no questions asked." } },
        { "type": "item", "settings": { "icon": "shield", "heading": "Made for nervous pets", "text": "Quiet motors and guarded blades." } },
        { "type": "item", "settings": { "icon": "chat", "heading": "Real humans", "text": "Pet-owning support team, replies within 24 hours." } }
      ]
    }
  ]
}
{% endschema %}
