{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign has_model = false
  for media in product.media
    if media.media_type == 'model'
      assign has_model = true
      break
    endif
  endfor
-%}

{%- if has_model -%}
  <link href="{{ 'model-viewer-ui.css' | shopify_asset_url }}" rel="stylesheet">
{%- endif -%}

<div class="section">
  <div class="page-width">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
      {% render 'icon', icon: 'chevron-right' %}
      {%- if collection -%}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
        {% render 'icon', icon: 'chevron-right' %}
      {%- endif -%}
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="product" data-product-root>
      {%- comment -%}---------------------------------------------- media {%- endcomment -%}
      <div class="product__media-wrapper product__gallery--{{ section.settings.gallery_layout }}">
        <div class="product__viewer">
          {%- if product.media.size > 1 -%}
            <button type="button" class="product__nav product__nav--prev" data-media-nav="prev" aria-label="{{ 'general.accessibility.previous' | t }}">
              {% render 'icon', icon: 'chevron-left' %}
            </button>
            <button type="button" class="product__nav product__nav--next" data-media-nav="next" aria-label="{{ 'general.accessibility.next' | t }}">
              {% render 'icon', icon: 'chevron-right' %}
            </button>
          {%- endif -%}

          <ul class="product__media-list" data-product-media>
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              <li class="product__media" data-media-id="{{ media.id }}" data-media-index="{{ forloop.index0 }}">
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    <button
                      type="button"
                      class="product__media-button"
                      data-lightbox="{{ media | image_url: width: 1800 }}"
                      data-lightbox-caption="{{ media.alt | escape }}"
                      aria-label="{{ 'general.accessibility.next' | t }}">
                      <img
                        src="{{ media | image_url: width: 1200 }}"
                        srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1800 }} 1800w"
                        sizes="(min-width: 990px) 55vw, 100vw"
                        alt="{{ media.alt | escape }}"
                        width="{{ media.preview_image.width }}"
                        height="{{ media.preview_image.height }}"
                        loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                        {% if forloop.first %}fetchpriority="high"{% endif %}>
                    </button>

                  {%- when 'video' -%}
                    <div class="product__media-video">
                      {{ media | video_tag: image_size: '1200x', controls: true, playsinline: true, preload: 'metadata' }}
                    </div>

                  {%- when 'external_video' -%}
                    <div class="product__media-video product__media-video--external">
                      {{ media | external_video_tag: loading: 'lazy' }}
                    </div>

                  {%- when 'model' -%}
                    <div class="product__media-model">
                      {{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true }}
                      <span class="badge badge--muted product__media-tag">3D</span>
                    </div>

                {%- endcase -%}
              </li>
            {%- endfor -%}
          {%- else -%}
            <li class="product__media">
              <div class="media media--square">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            </li>
          {%- endif -%}
          </ul>
        </div>

        {%- if product.media.size > 1 -%}
          <ul class="product__thumbs" data-product-thumbs>
            {%- for media in product.media -%}
              <li>
                <button
                  type="button"
                  class="product__thumb{% if forloop.first %} is-active{% endif %}"
                  data-media-target="{{ media.id }}"
                  aria-label="{{ media.media_type }} {{ forloop.index }}">
                  <img
                    src="{{ media.preview_image | image_url: width: 200 }}"
                    alt="{{ media.alt | escape }}"
                    width="90"
                    height="90"
                    loading="lazy">
                  {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                    <span class="product__thumb-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5Z"/></svg>
                    </span>
                  {%- elsif media.media_type == 'model' -%}
                    <span class="product__thumb-icon product__thumb-icon--text" aria-hidden="true">3D</span>
                  {%- endif -%}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%}---------------------------------------------- info {%- endcomment -%}
      <div class="product__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'vendor' -%}
              {%- if product.vendor != blank -%}
                <div class="card__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</div>
              {%- endif -%}

            {%- when 'title' -%}
              <h1 class="product__title h2" {{ block.shopify_attributes }}>{{ product.title }}</h1>

            {%- when 'rating' -%}
              <div class="rating" style="margin-bottom:1.6rem" {{ block.shopify_attributes }}>
                <span class="rating__stars" aria-hidden="true">
                  {%- for i in (1..block.settings.stars) -%}★{%- endfor -%}
                </span>
                <span>{{ block.settings.text }}</span>
              </div>

            {%- when 'price' -%}
              <div class="product__price" data-price-target {{ block.shopify_attributes }}>
                {% render 'price', product: product, use_variant: true, large: true, show_badges: true %}
              </div>

              {%- if block.settings.show_taxes_note -%}
                <p class="text-muted" style="font-size:1.3rem;margin-top:-0.8rem">
                  {{ 'cart.general.taxes_and_shipping' | t }}
                </p>
              {%- endif -%}

            {%- when 'stock' -%}
              <div style="margin-bottom:1.6rem" {{ block.shopify_attributes }}>
                <span
                  class="stock-indicator{% unless current_variant.available %} stock-indicator--out{% endunless %}"
                  data-stock
                  data-text-in="{{ 'products.product.in_stock' | t }}"
                  data-text-low="{{ 'products.product.low_stock' | t: count: '[count]' }}"
                  data-text-out="{{ 'products.product.inventory_out' | t }}">
                  {%- if current_variant.available -%}
                    {{ 'products.product.in_stock' | t }}
                  {%- else -%}
                    {{ 'products.product.inventory_out' | t }}
                  {%- endif -%}
                </span>
              </div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="product__description rte" {{ block.shopify_attributes }}>
                  {{ product.description }}
                </div>
              {%- endif -%}

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    {%- liquid
                      assign option_key = option.name | downcase
                      assign is_swatch = false
                      if option_key contains 'color' or option_key contains 'colour' or option_key contains 'farbe'
                        assign is_swatch = true
                      endif
                    -%}

                    <div class="variant-picker" data-option-index="{{ forloop.index0 }}">
                      <span class="variant-picker__label">
                        {{ option.name }}
                        <span data-selected-option>{{ option.selected_value }}</span>
                      </span>

                      <div class="variant-options{% if is_swatch %} variant-options--swatch{% endif %}">
                        {%- for value in option.values -%}
                          {%- liquid
                            assign input_id = section.id | append: '-' | append: forloop.parentloop.index | append: '-' | append: forloop.index
                            assign swatch_style = ''
                            if is_swatch
                              if value.swatch.image != blank
                                assign swatch_image = value.swatch.image | image_url: width: 100
                                assign swatch_style = 'background-image:url(' | append: swatch_image | append: ')'
                              elsif value.swatch.color != blank
                                assign swatch_style = 'background-color:' | append: value.swatch.color
                              else
                                assign fallback = value | downcase | split: ' ' | last | strip
                                assign swatch_style = 'background-color:' | append: fallback
                              endif
                            endif
                          -%}
                          <div class="variant-option">
                            <input
                              type="radio"
                              id="{{ input_id }}"
                              name="{{ option.name }}-{{ section.id }}"
                              value="{{ value | escape }}"
                              {% if option.selected_value == value %}checked{% endif %}>
                            <label for="{{ input_id }}"{% if is_swatch %} class="variant-option__swatch" title="{{ value | escape }}"{% endif %}>
                              {%- if is_swatch -%}
                                <span class="variant-option__chip" style="{{ swatch_style }}"></span>
                                <span class="visually-hidden">{{ value }}</span>
                              {%- else -%}
                                {{ value }}
                              {%- endif -%}
                            </label>
                          </div>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endfor -%}
                </div>
              {%- endunless -%}

            {%- when 'quantity_and_buy' -%}
              <div {{ block.shopify_attributes }}>
                {%- form 'product', product, id: 'ProductForm', class: 'product-form', novalidate: 'novalidate', data-product-form: 'true' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}">

                  <div class="product-form__row" style="margin-bottom:1.2rem">
                    <div class="quantity-selector" data-quantity>
                      <button type="button" data-quantity-change="down" aria-label="{{ 'products.product.decrease_quantity' | t }}">−</button>
                      <input
                        type="number"
                        name="quantity"
                        value="1"
                        min="1"
                        inputmode="numeric"
                        aria-label="{{ 'products.product.quantity' | t }}">
                      <button type="button" data-quantity-change="up" aria-label="{{ 'products.product.increase_quantity' | t }}">+</button>
                    </div>

                    <button
                      type="submit"
                      name="add"
                      class="btn"
                      data-submit
                      {% unless current_variant.available %}disabled{% endunless %}>
                      <span class="btn__text">
                        {%- if current_variant.available -%}
                          {{ 'products.product.add_to_cart' | t }}
                        {%- else -%}
                          {{ 'products.product.sold_out' | t }}
                        {%- endif -%}
                      </span>
                      <span class="spinner" aria-hidden="true"></span>
                    </button>
                  </div>

                  {%- if block.settings.show_dynamic_checkout -%}
                    {{ form | payment_button }}
                  {%- endif -%}
                {%- endform -%}
              </div>

            {%- when 'trust' -%}
              <ul class="product__trust" {{ block.shopify_attributes }}>
                {%- if block.settings.item_1 != blank -%}
                  <li>{% render 'icon', icon: 'truck' %}<span>{{ block.settings.item_1 }}</span></li>
                {%- endif -%}
                {%- if block.settings.item_2 != blank -%}
                  <li>{% render 'icon', icon: 'return' %}<span>{{ block.settings.item_2 }}</span></li>
                {%- endif -%}
                {%- if block.settings.item_3 != blank -%}
                  <li>{% render 'icon', icon: 'shield' %}<span>{{ block.settings.item_3 }}</span></li>
                {%- endif -%}
              </ul>

            {%- when 'collapsible' -%}
              <div class="accordion" style="margin-top:2.4rem" {{ block.shopify_attributes }}>
                <details>
                  <summary>
                    {{ block.settings.heading }}
                    {% render 'icon', icon: 'chevron-down' %}
                  </summary>
                  <div class="accordion__content rte">
                    {{ block.settings.content }}
                    {%- if block.settings.page != blank -%}
                      {{ block.settings.page.content }}
                    {%- endif -%}
                  </div>
                </details>
              </div>

            {%- when 'share' -%}
              <div style="margin-top:2.4rem" {{ block.shopify_attributes }}>
                <button
                  type="button"
                  class="link-arrow"
                  data-share="{{ shop.url }}{{ product.url }}"
                  data-share-copied="{{ 'general.share.copied' | t }}">
                  {{ 'general.share.copy_link' | t }}
                </button>
              </div>

            {%- when 'custom_liquid' -%}
              <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
          {%- endcase -%}
        {%- endfor -%}

        <div class="product__meta">
          {%- if current_variant.sku != blank -%}
            <span>{{ 'products.product.sku' | t }}: <span data-sku>{{ current_variant.sku }}</span></span>
          {%- endif -%}
        </div>

        <script type="application/json" data-variants>
          [
            {%- for variant in product.variants -%}
              {%- capture variant_price_html -%}
                {% render 'price', product: variant, large: true, show_badges: true %}
              {%- endcapture -%}
              {
                "id": {{ variant.id }},
                "available": {{ variant.available | json }},
                "options": {{ variant.options | json }},
                "price": {{ variant.price }},
                "compare_at_price": {{ variant.compare_at_price | default: 0 }},
                "sku": {{ variant.sku | json }},
                "inventory_management": {{ variant.inventory_management | json }},
                "inventory_quantity": {{ variant.inventory_quantity }},
                "url": {{ variant.url | json }},
                "featured_media": {% if variant.featured_media %}{ "id": {{ variant.featured_media.id }} }{% else %}null{% endif %},
                "price_html": {{ variant_price_html | strip | json }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        </script>
      </div>
    </div>
  </div>
</div>

{%- if section.settings.sticky_buy_bar -%}
  <div class="sticky-buy" data-sticky-buy>
    <div class="sticky-buy__info">
      {%- if product.featured_media -%}
        <img
          src="{{ product.featured_media | image_url: width: 120 }}"
          alt=""
          width="48"
          height="48"
          loading="lazy">
      {%- endif -%}
      <div class="sticky-buy__text">
        <span class="sticky-buy__title">{{ product.title | truncate: 42 | escape }}</span>
        <span data-price-target>{% render 'price', product: product, use_variant: true %}</span>
      </div>
    </div>

    <button type="button" class="btn" data-sticky-submit {% unless current_variant.available %}disabled{% endunless %}>
      <span class="btn__text">
        {%- if current_variant.available -%}
          {{ 'products.product.add_to_cart' | t }}
        {%- else -%}
          {{ 'products.product.sold_out' | t }}
        {%- endif -%}
      </span>
    </button>
  </div>
{%- endif -%}

{%- if has_model -%}
  <script src="{{ 'model-viewer-ui.js' | shopify_asset_url }}" defer></script>
{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "http://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ shop.url | append: product.url | json }},
    {% if product.featured_media -%}
      "image": [{{ product.featured_media | image_url: width: 1200 | prepend: "https:" | json }}],
    {%- endif %}
    "description": {{ product.description | strip_html | truncate: 400 | json }},
    {% if product.selected_or_first_available_variant.sku != blank -%}
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
    {%- endif %}
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "url": {{ shop.url | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "Gallery layout on desktop",
      "options": [
        { "value": "thumbnails", "label": "Large image with thumbnails" },
        { "value": "stacked", "label": "Stacked images" }
      ],
      "default": "thumbnails"
    },
    {
      "type": "checkbox",
      "id": "sticky_buy_bar",
      "label": "Sticky buy bar on mobile",
      "default": true
    }
  ],
  "blocks": [
    { "type": "vendor", "name": "Vendor", "limit": 1 },
    { "type": "title", "name": "Title", "limit": 1 },
    {
      "type": "rating",
      "name": "Rating",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_taxes_note", "label": "Show tax / shipping note", "default": true }
      ]
    },
    { "type": "stock", "name": "Stock indicator", "limit": 1 },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    {
      "type": "quantity_and_buy",
      "name": "Quantity and buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "default": true }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "trust",
      "name": "Trust badges",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "item_1", "label": "Item 1", "default": "Free US shipping — delivered in 5–8 business days" },
        { "type": "text", "id": "item_2", "label": "Item 2", "default": "30-day returns, no questions asked" },
        { "type": "text", "id": "item_3", "label": "Item 3", "default": "Express 2–4 business days available at checkout" }
      ]
    },
    {
      "type": "collapsible",
      "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & returns" },
        { "type": "richtext", "id": "content", "label": "Content" },
        { "type": "page", "id": "page", "label": "Or pull content from a page" }
      ]
    },
    { "type": "share", "name": "Share", "limit": 1 },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [{ "type": "liquid", "id": "custom_liquid", "label": "Liquid" }]
    }
  ]
}
{% endschema %}
