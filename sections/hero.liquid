{%- liquid
  assign has_media = false
  if section.settings.image != blank or section.settings.video != blank
    assign has_media = true
  endif
-%}

<div class="hero hero--{{ section.settings.height }}{% if has_media and section.settings.text_light %} hero--light{% endif %}">
  {%- if section.settings.video != blank -%}
    <div class="hero__media">
      {{
        section.settings.video
        | video_tag:
          image_size: '1600x',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true
      }}
    </div>
  {%- elsif section.settings.image != blank -%}
    <div class="hero__media">
      <img
        src="{{ section.settings.image | image_url: width: 2200 }}"
        srcset="{{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 1400 }} 1400w, {{ section.settings.image | image_url: width: 2200 }} 2200w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        fetchpriority="high">
    </div>
  {%- endif -%}

  <div class="hero__content">
    <div class="page-width">
      <div class="hero__inner hero__inner--{{ section.settings.alignment }}">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 class="h0">{{ section.settings.heading }}</h1>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <p class="hero__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        <div class="hero__buttons">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn">
              {{ section.settings.button_label }}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a href="{{ section.settings.button_link_2 }}" class="btn btn--secondary">
              {{ section.settings.button_label_2 }}
            </a>
          {%- endif -%}
        </div>

        {%- if section.settings.point_1 != blank or section.settings.point_2 != blank or section.settings.point_3 != blank -%}
          <ul class="hero__points">
            {%- if section.settings.point_1 != blank -%}
              <li>{% render 'icon', icon: 'check' %}{{ section.settings.point_1 }}</li>
            {%- endif -%}
            {%- if section.settings.point_2 != blank -%}
              <li>{% render 'icon', icon: 'check' %}{{ section.settings.point_2 }}</li>
            {%- endif -%}
            {%- if section.settings.point_3 != blank -%}
              <li>{% render 'icon', icon: 'check' %}{{ section.settings.point_3 }}</li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    {
      "type": "video",
      "id": "video",
      "label": "Background video",
      "info": "Plays muted on loop and replaces the background image."
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "text_light",
      "label": "Use light text over the image",
      "default": true
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Loved by 12,000+ pet parents" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Grooming days without the drama" },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Quiet nail grinders, muddy-paw cleaners and walk-ready gear — made for pets who'd rather be doing anything else."
    },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Shop bestsellers" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button", "default": "See how it works" },
    { "type": "url", "id": "button_link_2", "label": "Secondary button link" },
    { "type": "text", "id": "point_1", "label": "Highlight 1", "default": "Free EU shipping over €50" },
    { "type": "text", "id": "point_2", "label": "Highlight 2", "default": "30-day returns" },
    { "type": "text", "id": "point_3", "label": "Highlight 3", "default": "Ships in 24 hours" }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
