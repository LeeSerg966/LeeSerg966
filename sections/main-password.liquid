<div class="password-page">
  {%- if section.settings.image != blank -%}
    <div class="password-page__media">
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        alt="{{ section.settings.image.alt | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}">
    </div>
  {%- endif -%}

  <div class="password-page__content">
    <div class="page-width page-width--narrow text-center">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 320 }}"
          alt="{{ shop.name | escape }}"
          width="160"
          height="auto"
          style="margin:0 auto 2.4rem;max-width:160px">
      {%- else -%}
        <div class="header__logo" style="justify-content:center;margin-bottom:2.4rem">
          {% render 'icon', icon: 'paw' %}
          {{ shop.name }}
        </div>
      {%- endif -%}

      <h1>
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading }}
        {%- else -%}
          {{ 'sections.password.title' | t }}
        {%- endif -%}
      </h1>

      {%- if section.settings.text != blank -%}
        <div class="rte">{{ section.settings.text }}</div>
      {%- endif -%}

      <div style="max-width:44rem;margin:3.2rem auto 0">
        {%- form 'customer', class: 'newsletter__form newsletter--center' -%}
          <input type="hidden" name="contact[tags]" value="prelaunch">

          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success">{{ 'general.newsletter.success' | t }}</p>
          {%- endif -%}

          <div class="field">
            <label class="visually-hidden" for="PasswordNewsletter">{{ 'general.newsletter.label' | t }}</label>
            <input type="email" id="PasswordNewsletter" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" required>
          </div>
          <button type="submit" class="btn">{{ 'general.newsletter.submit' | t }}</button>
        {%- endform -%}
      </div>

      <hr class="divider">

      <details style="max-width:36rem;margin:0 auto">
        <summary style="cursor:pointer;font-size:1.4rem">{{ 'sections.password.login_form_heading' | t }}</summary>

        <div style="margin-top:1.6rem">
          {%- form 'storefront_password' -%}
            {%- if form.errors -%}
              <p class="form-message form-message--error">{{ 'sections.password.login_form_error' | t }}</p>
            {%- endif -%}

            <div class="field">
              <label class="visually-hidden" for="StorefrontPassword">{{ 'sections.password.login_form_password_label' | t }}</label>
              <input type="password" id="StorefrontPassword" name="password" placeholder="{{ 'sections.password.login_form_password_label' | t }}">
            </div>

            <button type="submit" class="btn btn--full">{{ 'sections.password.login_form_submit' | t }}</button>
          {%- endform -%}
        </div>
      </details>

      <p class="text-muted" style="font-size:1.3rem;margin-top:2.4rem">
        {{ 'sections.password.admin_link_html' | t }}
      </p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We're putting the finishing touches on the shop. Leave your email and you'll be first through the door.</p>"
    }
  ]
}
{% endschema %}
