<div class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page-width">
    <div class="newsletter-band{% if section.settings.image != blank %} newsletter-band--media{% endif %}">
      {%- if section.settings.image != blank -%}
        <div class="newsletter-band__media">
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            alt="{{ section.settings.image.alt | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy">
        </div>
      {%- endif -%}

      <div class="newsletter-band__content newsletter{% unless section.settings.image != blank %} newsletter--center text-center{% endunless %}">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="text-muted">{{ section.settings.description }}</p>
        {%- endif -%}

        {%- form 'customer', class: 'newsletter__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success">{{ 'general.newsletter.success' | t }}</p>
          {%- elsif form.errors -%}
            <p class="form-message form-message--error">{{ form.errors.messages.email }}</p>
          {%- endif -%}

          <div class="field">
            <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'general.newsletter.label' | t }}</label>
            <input
              type="email"
              id="NewsletterEmail-{{ section.id }}"
              name="contact[email]"
              placeholder="{{ 'general.newsletter.placeholder' | t }}"
              autocomplete="email"
              required>
          </div>

          <button type="submit" class="btn">{{ 'general.newsletter.submit' | t }}</button>
        {%- endform -%}

        {%- if section.settings.footnote != blank -%}
          <p class="text-muted" style="font-size:1.3rem;margin-top:1.2rem">{{ section.settings.footnote }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "10% off your first order" },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Join 12,000 pet parents getting care tips, new drops and subscriber-only offers."
    },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "No spam. Unsubscribe any time." },
    { "type": "checkbox", "id": "surface", "label": "Tinted background", "default": false }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
