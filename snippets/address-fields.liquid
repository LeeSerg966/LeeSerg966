{%- comment -%}Shared fields for the customer address forms.{%- endcomment -%}

<div class="field">
  <label>{{ 'customer.addresses.first_name' | t }}</label>
  <input type="text" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
</div>

<div class="field">
  <label>{{ 'customer.addresses.last_name' | t }}</label>
  <input type="text" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
</div>

<div class="field">
  <label>{{ 'customer.addresses.company' | t }}</label>
  <input type="text" name="address[company]" value="{{ form.company }}" autocomplete="organization">
</div>

<div class="field">
  <label>{{ 'customer.addresses.address1' | t }}</label>
  <input type="text" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1">
</div>

<div class="field">
  <label>{{ 'customer.addresses.address2' | t }}</label>
  <input type="text" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2">
</div>

<div class="field">
  <label>{{ 'customer.addresses.city' | t }}</label>
  <input type="text" name="address[city]" value="{{ form.city }}" autocomplete="address-level2">
</div>

<div class="field">
  <label>{{ 'customer.addresses.country' | t }}</label>
  <select name="address[country]" autocomplete="country">
    {{ country_option_tags }}
  </select>
</div>

<div class="field">
  <label>{{ 'customer.addresses.province' | t }}</label>
  <input type="text" name="address[province]" value="{{ form.province }}" autocomplete="address-level1">
</div>

<div class="field">
  <label>{{ 'customer.addresses.zip' | t }}</label>
  <input type="text" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code">
</div>

<div class="field">
  <label>{{ 'customer.addresses.phone' | t }}</label>
  <input type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel">
</div>

<label class="facet__option" style="margin-bottom:1.6rem">
  {{ form.set_as_default_checkbox }}
  <span>{{ 'customer.addresses.set_default' | t }}</span>
</label>
